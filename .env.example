OPENAI_API_KEY=
# Payment Widget용 gsk/gck 키를 같은 환경(test 또는 live) 쌍으로 설정한다.
TOSS_SECRET_KEY=
TOSS_CLIENT_KEY=
# 실결제 키·웹훅·환불 설정을 모두 검증한 뒤에만 true로 전환한다.
PAYMENTS_ENABLED=false
# live 키로 전환하면 자동 환불이 기본으로 꺼진다. 실결제를 열 때 반드시 true로 둘 것.
PAYMENT_REFUNDS_ENABLED=false
PORT=3000
SESSION_SECRET=
NODE_ENV=production
BENCHMARK_TRANSCRIPTION_LOG_ID=
BENCHMARK_RUNS=1
USD_KRW=
# 배포 후 공개 페이지를 Bing·네이버에 자동 통보한다. 운영 도메인에서만 true로 둔다.
INDEXNOW_ENABLED=false
CAPTION_IDEAS_ENABLED=true
CAPTION_IDEAS_MODEL=gpt-5.6-luna


# Enable only after the durable operation migration and deployment checks.
TRANSCRIPTION_OPERATIONS_ENABLED=false
# Silence-hallucination shadow observation only; "shadow" logs aggregate candidates without changing subtitles.
SILENCE_OBSERVATION_MODE=off

# Outreach admin is separate from regular app users. Comma-separated Supabase user UUIDs.
OUTREACH_ADMIN_USER_IDS=
# Keep false until migration and configuration are validated. Self-tests also require true.
OUTREACH_SENDING_ENABLED=false
# Naver SMTP account/from/reply-to are fixed to codemeet@naver.com.
# Set an application password on the server only. Never put it in VITE_* variables.
OUTREACH_SMTP_PASSWORD=
# 587 requires STARTTLS; 465 uses implicit TLS. Certificate verification stays enabled.
OUTREACH_SMTP_PORT=587
OUTREACH_SEND_INTERVAL_SECONDS=60
OUTREACH_DAILY_LIMIT=25
# YouTube Data API v3 key for channel metadata only; no email extraction.
YOUTUBE_API_KEY=
# Public HTTPS origin used in unsubscribe links. Use the deployment's actual origin.
APP_URL=https://pr-text.com

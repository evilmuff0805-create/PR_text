OPENAI_API_KEY=
# Payment Widget용 gsk/gck 키를 같은 환경(test 또는 live) 쌍으로 설정한다.
TOSS_SECRET_KEY=
TOSS_CLIENT_KEY=
# 실결제 키·웹훅·환불 설정을 모두 검증한 뒤에만 true로 전환한다.
PAYMENTS_ENABLED=false
# live 키로 전환하면 자동 환불이 기본으로 꺼진다. 실결제를 열 때 반드시 true로 둘 것.
PAYMENT_REFUNDS_ENABLED=false
PORT=3000
SESSION_SECRET=
NODE_ENV=production
BENCHMARK_TRANSCRIPTION_LOG_ID=
BENCHMARK_RUNS=1
USD_KRW=
CAPTION_IDEAS_ENABLED=true
CAPTION_IDEAS_MODEL=gpt-5.6-luna

